<div class="d-flex justify-content-between align-items-center mb-3">
  <div class="dropdown">
    <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="teamDropdown" data-bs-toggle="dropdown" aria-expanded="false">
      <%= @bdlteam.full_name %>
      <i class="bi bi-chevron-down"></i> <!-- Petite flèche -->
    </button>
    <ul class="dropdown-menu" aria-labelledby="teamDropdown">
      <% Bdlteam.all.each do |team| %>
        <li>
          <%= link_to team.full_name, bdlteam_path(team), class: "dropdown-item" %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
